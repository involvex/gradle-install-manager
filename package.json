{
	"name": "@involvex/gradle-install-manager",
	"private": true,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/involvex/gradle-install-manager.git"
	},
	"author": "Involvex",
	"type": "module",
	"module": "src/index.ts",
	"bin": {
		"gim": "src/index.ts",
		"gradle-install-manager": "src/index.ts"
	},
	"scripts": {
		"prebuild": "bun run format && bun run typecheck && bun run lint:fix",
		"build": "bun build src/index.ts --outdir dist --target bun",
		"build:watch": "bun build src/index.ts --outdir dist --target bun --watch",
		"dev": "bun --watch src/index.ts",
		"format": "prettier . --write",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"start": "bun run src/index.ts",
		"typecheck": "tsc --noEmit"
	},
	"prettier": "@involvex/prettier-config",
	"dependencies": {
		"@types/bun": "^1.3.14",
		"bun": "^1.3.14"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@involvex/prettier-config": "^0.0.5",
		"eslint": "^10.4.1",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1"
	}
}
